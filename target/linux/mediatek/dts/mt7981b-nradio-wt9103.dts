// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * NRadio C8-660 (ODM board WT9103, MT7981B)
 *
 * 3x GbE on MT7531 + 1x 2.5G on switch port 5, 2.5G WAN on gmac1,
 * 512 MiB SPI-NAND, M.2 5G module on USB (powered by cpe-pwr).
 *
 * Pin map / PHY / partition offsets come from NRadio's own second-system DTS
 * (mt7981-nradio-wt9103-2nd.dts + mt7981-nradio-snand-2nd.dtsi, published with
 * "鲲鹏双系统第二系统开发适配指南"); hanwckf's mt7981-nradio-wt9103{,-512m}.dts
 * agrees except for the WPS polarity. Only difference here: single-system flash
 * layout (one ubi instead of ubi_1st + app_data + ubi_2nd).
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/mt65xx.h>

#include "mt7981b.dtsi"

/ {
	model = "NRadio C8-660";
	compatible = "nradio,c8-660", "mediatek,mt7981";

	aliases {
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* 5G module power rail and SIM slot select, driven from userspace */
	/* 5G module power rail and SIM slot select, exported to userspace.
	 * The "gpio-export" driver ships in OpenWrt's generic patch
	 * 800-GPIO-add-named-gpio-exports (built via CONFIG_GPIO_SYSFS),
	 * so no extra package is required. */
	gpio-export {
		compatible = "gpio-export";

		cpepower {
			gpio-export,name = "cpe-pwr";
			gpio-export,output = <0>;
			gpios = <&pio 25 GPIO_ACTIVE_LOW>;
		};

		cpesel0 {
			gpio-export,name = "cpe-sel0";
			gpio-export,output = <1>;
			gpios = <&pio 24 GPIO_ACTIVE_HIGH>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};

		button-wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";

		led_status: led-0 {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pio 10 GPIO_ACTIVE_LOW>;
		};

		led_5g: led-1 {
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <0>;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pio 11 GPIO_ACTIVE_LOW>;
		};

		led_4g: led-2 {
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <1>;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pio 12 GPIO_ACTIVE_LOW>;
		};

		led_wifi: led-3 {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
		};
	};
};

&eth {
	status = "okay";

	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";

		fixed-link {
			speed = <2500>;
			full-duplex;
			pause;
		};
	};

	gmac1: mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "2500base-x";

		/* WAN: fixed 2.5G link, same as the vendor 2nd-system DTS.
		 * phy21 is still probed below but not attached to the MAC. */
		fixed-link {
			speed = <2500>;
			full-duplex;
			pause;
		};
	};

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;

		/* 2.5G ports: MaxLinear GPY211B (PHY ID 0x67c9de0a), own reset GPIO each.
		 * Values taken from hanwckf/immortalwrt-mt798x (mt7981-nradio-wt9103.dts). */
		phy5: ethernet-phy@5 {
			compatible = "ethernet-phy-id67c9.de0a";
			reg = <5>;
			phy-mode = "2500base-x";
			reset-gpios = <&pio 7 GPIO_ACTIVE_LOW>;
			reset-assert-us = <600>;
			reset-deassert-us = <20000>;
		};

		phy21: ethernet-phy@21 {
			compatible = "ethernet-phy-id67c9.de0a";
			reg = <21>;
			phy-mode = "2500base-x";
			reset-gpios = <&pio 8 GPIO_ACTIVE_LOW>;
			reset-assert-us = <600>;
			reset-deassert-us = <20000>;
		};

		switch@1f {
			compatible = "mediatek,mt7531";
			reg = <31>;
			/* Vanilla kernel convention: upstream uses ACTIVE_HIGH on every
			 * MT7981 board with this switch (c8-668gl, rax3000m, 360t7).
			 * X-WRT's ACTIVE_LOW goes together with their kernel patch
			 * "net: dsa: mt7530: fix reset polarity" (eaee5d2f), not usable here. */
			reset-gpios = <&pio 39 GPIO_ACTIVE_HIGH>;
			interrupt-controller;
			#interrupt-cells = <1>;
			interrupt-parent = <&pio>;
			interrupts = <38 IRQ_TYPE_LEVEL_HIGH>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@1 {
					reg = <1>;
					label = "lan1";
				};

				port@2 {
					reg = <2>;
					label = "lan2";
				};

				port@3 {
					reg = <3>;
					label = "lan3";
				};

				port@5 {
					reg = <5>;
					label = "lan4";
					phy-mode = "2500base-x";
					phy-handle = <&phy5>;
				};

				port@6 {
					reg = <6>;
					label = "cpu";
					ethernet = <&gmac0>;
					phy-mode = "2500base-x";

					fixed-link {
						speed = <2500>;
						full-duplex;
						pause;
					};
				};
			};
		};
	};
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	spi_nand: flash@0 {
		compatible = "spi-nand";
		reg = <0>;

		spi-cal-enable;
		spi-cal-mode = "read-data";
		spi-cal-datalen = <7>;
		spi-cal-data = /bits/ 8 <0x53 0x50 0x49 0x4e 0x41 0x4e 0x44>;
		spi-cal-addrlen = <5>;
		spi-cal-addr = /bits/ 32 <0x0 0x0 0x0 0x0 0x0>;

		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;

		mediatek,nmbm;
		mediatek,bmt-max-ratio = <1>;
		mediatek,bmt-max-reserved-blocks = <64>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL2";
				reg = <0x0 0x100000>;
				read-only;
			};

			partition@100000 {
				label = "u-boot-env";
				reg = <0x100000 0x80000>;
			};

			factory: partition@180000 {
				label = "factory";
				reg = <0x180000 0x180000>;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x1000>;
					};
				};
			};

			partition@300000 {
				label = "bdinfo";
				reg = <0x300000 0x80000>;
			};

			partition@380000 {
				label = "FIP";
				reg = <0x380000 0x200000>;
				read-only;
			};

			/* Single system: one ubi over the whole tail.
			 * Vendor layout would be ubi(ubi_1st) 64M + app_data 16M + ubi_2nd
			 * 0x1AA80000 here; those three are merged on purpose. */
			partition@580000 {
				label = "ubi";
				reg = <0x580000 0x1fa80000>;
				compatible = "linux,ubi";
			};
		};
	};
};

&pio {
	spi0_flash_pins: spi0-pins {
		mux {
			function = "spi";
			groups = "spi0", "spi0_wp_hold";
		};

		conf-pu {
			pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP";
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_11>;
		};

		conf-pd {
			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO";
			drive-strength = <MTK_DRIVE_8mA>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_11>;
		};
	};
};

&uart0 {
	status = "okay";
};

&usb_phy {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&wifi {
	nvmem-cells = <&eeprom_factory_0>;
	nvmem-cell-names = "eeprom";
	status = "okay";
};

&xhci {
	status = "okay";
};
